#!/usr/bin/env bash
# ccusage-wrapper — Generate JSON for Plasma Token Usage widget
# Writes to ~/.cache/ccusage/tokenusage.json

set -euo pipefail

CACHE_DIR="$HOME/.cache/ccusage"
OUTPUT_FILE="$CACHE_DIR/tokenusage.json"

# Ensure cache dir exists
mkdir -p "$CACHE_DIR"

# Run ccusage and write JSON
if ccusage daily --json --no-color 2>/dev/null > "$OUTPUT_FILE.tmp"; then
    mv "$OUTPUT_FILE.tmp" "$OUTPUT_FILE"
    echo "ok"
else
    # Write error JSON if ccusage fails
    echo '{"error":"ccusage failed","daily":[],"totals":{}}' > "$OUTPUT_FILE"
    rm -f "$OUTPUT_FILE.tmp"
    echo "error"
fi
